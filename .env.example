# Copy this file to .env (or .env.local) and fill in the values you have.
# Every integration below degrades gracefully when left unset — see README.md
# "Running without any external credentials" for what still works out of the box.

# --- Core ---------------------------------------------------------------
# Any long random string. Used to sign session cookies (HS256 JWT).
AUTH_SECRET=replace-with-a-long-random-string

# SQLite file path (created automatically). Rarely needs changing.
DATABASE_FILE=./data/app.db

# IANA timezone the clinic operates in — used to interpret doctor working
# hours and to render appointment times in emails/UI.
CLINIC_TIMEZONE=Asia/Kolkata

# --- LLM (pre-visit + post-visit summaries) ------------------------------
# Anthropic API key. Leave blank to run in "simulated" mode: the app uses a
# deterministic rule-based summary generator instead of a live model call,
# so the whole flow still works with zero cost/setup.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-3-5-haiku-20241022

# --- Email (booking confirmations, reminders, cancellations) ------------
# Any SMTP-compatible provider works: SendGrid, Mailgun, Postmark, Gmail
# SMTP, Mailtrap (for testing), etc. Leave SMTP_HOST blank to run in
# "simulated" mode: emails are logged to the server console instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Healthcare Clinic <no-reply@clinic.example>"

# Optional: force a percentage of simulated emails to fail, to exercise the
# notification retry/backoff logic without a real SMTP outage. 0.3 = 30%.
EMAIL_SIMULATE_FAILURE_RATE=0

# --- Google Calendar (OAuth2) --------------------------------------------
# From a Google Cloud OAuth 2.0 Client ID (Web application). See README.md
# "Google Calendar setup" for the click-by-click steps. Leave blank to skip
# calendar sync entirely — bookings/cancellations still work normally.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/calendar/callback

# --- Background worker ----------------------------------------------------
# Cron schedule for the standalone worker process (`npm run worker`).
WORKER_CRON_SCHEDULE=*/2 * * * *
# Shared secret required on the x-worker-secret header when triggering
# /api/worker/tick externally (e.g. Vercel Cron). Leave blank in local dev.
WORKER_SECRET=
